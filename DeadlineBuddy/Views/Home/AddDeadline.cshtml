@{
    ViewData["Title"] = "Add Deadline";
}

<div class="dashboard">
    <section class="deadlines">
        <h1>Add a Deadline</h1>
        <p>Enter your academic task details below.</p>

        <form asp-action="AddDeadline" method="post">
            <div class="form-group mb-3">
                <label for="Title">Task Name</label>
                <input id="Title" name="Title" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label for="Subject">Subject</label>
                <input id="Subject" name="Subject" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label for="DueDate">Due Date</label>
                <input id="DueDate" name="DueDate" type="date" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label for="Category">Task Category</label>
                <select id="Category" name="Category" class="form-control" required>
                    <option value="">Choose a category</option>
                    <option>Assignment</option>
                    <option>Test</option>
                    <option>Project</option>
                    <option>Exam</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="Priority">Priority</label>
                <select id="Priority" name="Priority" class="form-control" required>
                    <option value="">Choose priority</option>
                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save Deadline</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </section>
</div>
